+#ifdef HAVE_LINUX_NETWORK
+static int have_default_route(const char *lan_iface)
+{
+  FILE *fp = fopen("/proc/net/ipv6_route", "r");
+  char line[512], dest[33], source[33], gateway[33], iface[IF_NAMESIZE];
+  unsigned int dest_len, source_len, metric, refcnt, use, flags;
+  int found = 0;
+  const char *zero = "00000000000000000000000000000000";
+
+  if (!fp)
+    return 0;
+
+  while (fgets(line, sizeof(line), fp))
+    {
+      struct ifreq ifr;
+      int fd;
+      if (sscanf(line, "%32s %x %32s %x %32s %x %x %x %x %15s",
+                 dest, &dest_len, source, &source_len, gateway,
+                 &metric, &refcnt, &use, &flags, iface) != 10 ||
+          dest_len != 0 || source_len != 0 || strcmp(dest, zero) ||
+          !(flags & 0x1) || (flags & 0x200) || !strcmp(iface, lan_iface) ||
+          !strcmp(iface, "lo"))
+        continue;
+
+      fd = socket(AF_INET6, SOCK_DGRAM, 0);
+      memset(&ifr, 0, sizeof(ifr));
+      strncpy(ifr.ifr_name, iface, sizeof(ifr.ifr_name) - 1);
+      if (fd == -1)
+        continue;
+      if (ioctl(fd, SIOCGIFFLAGS, &ifr) == -1 || !(ifr.ifr_flags & IFF_UP) ||
+          !(ifr.ifr_flags & IFF_RUNNING) ||
+          (!strcmp(gateway, zero) && !(ifr.ifr_flags & IFF_POINTOPOINT)))
+        { close(fd); continue; }
+      close(fd);
+      found = 1;
+      break;
+    }
+  fclose(fp);
+  return found;
+}
+#endif
